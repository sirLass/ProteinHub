generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  contactNumber String?
  ageRange      String?
  source        String?
  scheduleSlot  String?
  interestLevel String?
  referrerId    String?
  role          String    @default("PROSPECT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
